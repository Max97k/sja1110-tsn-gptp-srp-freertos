# Do no remove this
SHELL := /bin/bash
# Look for project name in .project. It is always the first entry with name
CMD:=grep -m1 -o -P --regexp="(?<=<name>).*(?=</name)" ../.project
EXECUTABLES := $(shell $(CMD)).elf

SCRIPT_PATH := ../tool/createNvmImage.py
DBSCRIPT_PATH := ../tool/createDBImage.py

user_all: all binToElf

binaryName := $(subst .elf,.bin, $(EXECUTABLES))
binaryName := $(strip $(binaryName))

generateBin: all
	@echo "Generating flash image..."
	arm-none-eabi-objcopy.exe -O binary $(EXECUTABLES) $(binaryName)

updateBin: generateBin
	@echo Running image generation script from: "$(SCRIPT_PATH)"
	@py.exe "$(SCRIPT_PATH)" -bf="${CWD}/$(binaryName)"

# -bfaddr: first partition address (must greater than or equal to 24 and is multiple of 8)
# -bfsize: partition size (must greater than or equal to the firmware binary: __nvmImageHeaderSection_end__ in .map file + secure context if enabled)
# The first image is placed at offset (bfaddr) and the second image (backup) is placed at offset (bfaddr + bfsize)
dualbankBin: updateBin
	@echo Running dual bank image generation script from: "$(DBSCRIPT_PATH)"
	@py.exe "$(DBSCRIPT_PATH)" -bf="${CWD}/flash_image.bin" -bfsize="256000" -bfaddr="24"

binToElf: dualbankBin
	arm-none-eabi-objcopy.exe --input-target=binary --output-target=elf32-little --change-addresses=0x41000000 flash_image.bin app_flash.elf

